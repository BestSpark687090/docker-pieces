https:// {
    tls {
        on_demand
    }
    @studyready host interactiveextendedlearning.org mcdonalds-in-the-pentagon.com mcdonalds-in-the-pentagon.online mcdonalds-in-the-pentagon.org mcdonalds-in-the-pentagon.store
    handle @studyready {
        root * /studyready
        file_server
    }
    reverse_proxy bestspark-site:8080 {
        header_up X-Forwarded-For {remote_host}
    }
    handle_errors 502 503 {
	root * /etc/caddy/errors
	rewrite * /server-down.html
	file_server
    }

}

http:// {
    @studyready host interactiveextendedlearning.org mcdonalds-in-the-pentagon.com mcdonalds-in-the-pentagon.online mcdonalds-in-the-pentagon.org mcdonalds-in-the-pentagon.store
    handle @studyready {
        root * /studyready
        file_server
    }
    @fromcloudfront {
        header X-Origin-Verify cloudfront
    }
    handle @fromcloudfront {
        reverse_proxy bestspark-site:8080
    }
    handle {
        redir https://{host}{uri} 308
    }
}
