https:// {
    tls {
        on_demand
    }
    import wildcard_dns_ban_log
    @studyready host interactiveextendedlearning.org mcdonalds-in-the-pentagon.com mcdonalds-in-the-pentagon.online mcdonalds-in-the-pentagon.org mcdonalds-in-the-pentagon.store
    handle @studyready {
        root * /studyready
        file_server
    }
    @sparky path /sparky/*
    handle @sparky {
        uri strip_prefix /sparky
        basic_auth {
            {env.SPARKY_USER} {env.SPARKY_PASSWORD_HASH}
        }
        reverse_proxy host.docker.internal:3131
    }
    reverse_proxy bestspark-site:8080 {
        header_up X-Forwarded-For {remote_host}
    }
    handle_errors 502 503 {
	root * /etc/caddy/errors
	rewrite * /server-down.html
	file_server
    }

}

