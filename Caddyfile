	{
    auto_https off
    on_demand_tls {
        ask http://validator:9000
    }
    log {
        level ERROR
    }
    cert_issuer acme https://acme.zerossl.com/v2/DV90 {
        eab {env.ACME_EAB_KEY_ID} {env.ACME_EAB_MAC_KEY}
    }
    cert_issuer acme https://acme-v02.api.letsencrypt.org/directory
}
(wildcard_dns_ban_log) {
    # BEGIN wildcard-dns-domains (generated by sync-wildcard-domains.py -- edit /home/www/wildcard-dns-domains.txt, not this block)
    @wildcard_ip_dns_junk header_regexp Host (?i)(^|\.)(local\-ip\.co|local\-ip\.sh|nip\.io|sslip\.io|traefik\.me|v6\.army|v6\.rocks|v6\.navy|dns\.army|plesk\.page|a\-i\.st|a\-i\.sh|backname\.io|xip\.lhjmmc\.cn|glueops\-testing[a-z0-9.-]*|nar0\.com)(:\d+)?$
    @not_wildcard_ip_dns_junk {
        not header_regexp Host (?i)(^|\.)(local\-ip\.co|local\-ip\.sh|nip\.io|sslip\.io|traefik\.me|v6\.army|v6\.rocks|v6\.navy|dns\.army|plesk\.page|a\-i\.st|a\-i\.sh|backname\.io|xip\.lhjmmc\.cn|glueops\-testing[a-z0-9.-]*|nar0\.com)(:\d+)?$
    }
    # END wildcard-dns-domains
    @known_good_local_ip header_regexp Host (?i)^(bestspark\.|study[a-z]{3,5}\.|)(15\.204\.67\.205|15-204-67-205)\.my\.local-ip\.co(:\d+)?$
    log_skip @not_wildcard_ip_dns_junk
    log_skip @known_good_local_ip
    log {
        output file /var/log/caddy/bad-hosts.log
        format filter {
            wrap console
            fields {
                request>headers delete
                request>tls delete
                resp_headers delete
            }
        }
    }
}

